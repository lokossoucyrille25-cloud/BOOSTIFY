{
  "id": "/",
  "name": "Boostify",
  "short_name": "Boostify",
  "description": "Boostez vos réseaux sociaux en Afrique de l'Ouest (TikTok, Instagram, Facebook, YouTube, Telegram) avec paiement Mobile Money en FCFA.",
